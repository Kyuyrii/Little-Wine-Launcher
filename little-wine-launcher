def load_translations() -> tuple[dict, list[tuple[str, str]]]:
    """Loads translations from TOML files.

    Returns:
        tuple: (translations dict keyed by lang_code,
                list of (language_name, lang_code) tuples)
    """
    toml_translations: dict[str, dict] = {}
    toml_languages: list[tuple[str, str]] = []
    seen_codes: set[str] = set()

    app_dir = Path(__file__).resolve().parent
    translation_dirs = [
        app_dir / "translation",
        Path(sys.argv[0]).resolve().parent / "translation",
        lwl_dir / "translation",
    ]
    if "XDG_DATA_DIRS" in os.environ:
        for path in os.environ["XDG_DATA_DIRS"].split(":"):
            translation_dirs.append(Path(path) / "Little-Wine-Launcher" / "translation")
    else:
        translation_dirs.append(Path("/usr/share/Little-Wine-Launcher/translation"))
        translation_dirs.append(Path("/usr/local/share/Little-Wine-Launcher/translation"))

    for translation_folder in translation_dirs:
        if translation_folder.exists():
            for toml_file in translation_folder.glob("lwl-translation-*.toml"):
                try:
                    lang_code = toml_file.stem.replace("lwl-translation-", "")
                    if lang_code in seen_codes:
                        continue
                    with open(toml_file, "r", encoding="utf-8") as f:
                        import tomlkit
                        lang_data = tomlkit.load(f)
                    toml_translations[lang_code] = lang_data
                    lang_name = lang_data.get("language_name", lang_code)
                    toml_languages.append((lang_name, lang_code))
                    seen_codes.add(lang_code)
                    print(f"[LWL]: Loaded translation: {lang_name} ({lang_code})")
                except Exception as e:
                    print(f"[LWL]: Error loading translation {toml_file}: {e}")

    return toml_translations, toml_languages


available_translations, available_languages = load_translations()


def create_default_settings() -> dict:
    """Provides default settings for first-time creation."""
    return {
        "design": {
            "language": LANG if LANG in available_translations else "en_US",
        },
        "shortcut": {
            "desktop_dir": "",
            "applications_dir": "",
        },
    }


def load_settings() -> dict:
    """Loads settings, falls back to defaults if file is missing/corrupt."""
    defaults = create_default_settings()
    try:
        import tomlkit
        if lwl_settings_file.is_file():
            with open(lwl_settings_file, "r", encoding="utf-8") as f:
                data = dict(tomlkit.load(f))
        else:
            save_settings(defaults)
            return defaults
    except Exception as e:
        print(f"[LWL]: failed to load settings: {e}")
        return defaults

    # Remove outdated or unknown top-level keys
    for key in list(data.keys()):
        if key not in defaults:
            del data[key]

    # Ensure missing top-level sections exist
    for key, value in defaults.items():
        data.setdefault(key, value)

    # Ensure missing keys inside each section
    for section in defaults:
        for key, value in defaults[section].items():
            data[section].setdefault(key, value)

    # Remove outdated keys inside sections
    for section in defaults:
        for key in list(data[section].keys()):
            if key not in defaults[section]:
                del data[section][key]

    # Validate language
    saved_lang = data["design"].get("language", "en_US")
    if saved_lang not in available_translations:
        data["design"]["language"] = "en_US"
        save_settings(data)

    return data


def save_settings(data: dict) -> bool:
    """Saves settings in TOML."""
    try:
        import tomlkit
        lwl_config_dir.mkdir(parents=True, exist_ok=True)
        lwl_settings_file.parent.mkdir(parents=True, exist_ok=True)
        with open(lwl_settings_file, "w", encoding="utf-8") as f:
            tomlkit.dump(data, f)
        return True
    except Exception as e:
        print(f"[LWL]: failed to save settings: {e}")
        return False


