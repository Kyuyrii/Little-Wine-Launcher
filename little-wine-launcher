    # Adds a labelled entry + browse-button row and returns the entry.
    def _folder_row(self, content: Gtk.Box, label: str, initial: Path) -> Gtk.Entry:
        content.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        entry = Gtk.Entry()
        entry.set_text(str(initial))
        row.pack_start(entry, True, True, 0)
        btn = Gtk.Button.new_from_icon_name("folder-open-symbolic", Gtk.IconSize.BUTTON)
        btn.connect("clicked", partial(self._browse, entry))
        row.pack_start(btn, False, False, 0)
        content.pack_start(row, False, False, 0)
        return entry

    # Opens a folder chooser and puts the result in entry.
    def _browse(self, entry: Gtk.Entry, *_args) -> None:
        open_file_chooser(
            self, tr("SETTINGS"), on_accept=entry.set_text,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )

    def _show_info(self, *_args) -> None:
        show_message(self, Gtk.MessageType.INFO, tr("INFO_TITLE"), tr("INFO_MESSAGE"))

    def _save(self, *_args) -> None:
        settings = load_settings()
        idx = self.lang_combo.get_active()
        settings["design"]["language"] = self.lang_codes[idx] if idx >= 0 else "en_US"
        settings["shortcut"]["desktop_dir"] = self.desktop_entry.get_text().strip()
        settings["shortcut"]["applications_dir"] = self.applications_entry.get_text().strip()
        save_settings(settings)
        self.destroy()


# Shows the native GTK removal confirmation dialog.
def show_remove_bubble_dialog(app: "App", parent: Gtk.Window, toml_path: Path, name: str) -> None:
    response = show_message(
        parent, Gtk.MessageType.QUESTION, tr("REMOVE_BUBBLE_TITLE"),
        tr("REMOVE_BUBBLE_BODY", name=name), buttons=Gtk.ButtonsType.YES_NO,
    )
    if response != Gtk.ResponseType.YES:
        return

    safe_name = bubble_safe_name(name)
    desktop_dir, applications_dir = get_shortcut_dirs()
    remove_bubble_desktop(desktop_dir, safe_name)
    remove_bubble_desktop(applications_dir, safe_name)
    try:
        toml_path.unlink()
    except Exception:
        pass
    remove_icon_for_bubble(safe_name)
    app.refresh_main()


