        icon_renderer.set_property("xpad", 8)
        icon_renderer.set_property("ypad", 6)
        icon_col = Gtk.TreeViewColumn("", icon_renderer)
        icon_col.set_cell_data_func(icon_renderer, self._icon_data_func)
        self.treeview.append_column(icon_col)

        text_renderer = Gtk.CellRendererText()
        text_renderer.set_property("ellipsize", 3)
        text_renderer.set_property("ypad", 6)
        text_col = Gtk.TreeViewColumn("", text_renderer, text=2)
        text_col.set_expand(True)
        self.treeview.append_column(text_col)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_shadow_type(Gtk.ShadowType.NONE)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.treeview)
        self.content.pack_start(scroll, True, True, 0)

        self._update_menu_sensitivity()
        self.refresh()
        self.show_all()

    # ---- callbacks ----
    def _on_search_changed(self, *_args) -> None:
        """Callback for search entry changes."""
        self._apply_filter()

    def _on_selection_changed(self, *_args) -> None:
        """Callback for tree selection changes."""
        self._update_menu_sensitivity()

    def _on_update_shortcuts(self, *_args) -> None:
        """Callback for Update Shortcuts menu item."""
        regenerate_shortcuts(self.app)

    def _on_settings(self, *_args) -> None:
        """Callback for Settings menu item."""
        self._settings()

    def _on_about(self, *_args) -> None:
        """Callback for About menu item."""
        self._about()

    def _on_tree_button_press(self, treeview: Gtk.TreeView, event) -> bool:
        """Right-click context menu handler."""
        if event.button != 3:
            return False
        path_info = treeview.get_path_at_pos(int(event.x), int(event.y))
        if path_info is None:
            return False
        path = path_info[0]
        treeview.get_selection().select_path(path)
        self._show_context_menu(event)
        return True

    def _on_row_activated(self, treeview: Gtk.TreeView, path, column) -> None:
        """Row double-click handler."""
        model = treeview.get_model()
        treeiter = model.get_iter(path)
        toml_path = Path(model[treeiter][1])
        data = load_bubble(toml_path)
        if data:
            self._execute(data=data)

    # ---- icon renderer ----
    def _icon_data_func(self, column, cell, model, treeiter, _data) -> None:
        """Sets the icon for a bubble row."""
        icon_path = model[treeiter][0]
        if icon_path and Path(icon_path).is_file():
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_path, 64, 64, True)
                cell.set_property("pixbuf", pixbuf)
                return
            except Exception:
                pass
        cell.set_property("pixbuf", None)
        cell.set_property("icon-name", "wine")
        cell.set_property("stock-size", Gtk.IconSize.LARGE_TOOLBAR)

    # ---- filter ----
    def _filter_func(self, model, treeiter, _data) -> bool:
        """TreeView filter function."""
        text = self.search_entry.get_text().strip().lower()
        if not text:
            return True
        return text in (model[treeiter][2] or "").lower()

    def _apply_filter(self) -> None:
        """Refilters the treeview."""
        self.filter_model.refilter()

    # ---- data ----
    def refresh(self) -> None:
        """Reloads the bubble list."""
        self.store.clear()
        for path, data in list_bubbles():
            gui_path = data.get("gui_path", "")
            name = data.get("name", path.stem)
            self.store.append([gui_path, str(path), name])
        self._update_menu_sensitivity()

    def _selected_toml_path(self) -> Path | None:
        """Returns the selected bubble's TOML path."""
        model, treeiter = self.treeview.get_selection().get_selected()
        if treeiter is None:
            return None
        return Path(model[treeiter][1])

    def _selected_data(self) -> tuple[Path | None, dict | None]:
        """Returns the selected bubble's (path, data)."""
        p = self._selected_toml_path()
        if p is None:
            return None, None
        return p, load_bubble(p)

    def _update_menu_sensitivity(self) -> None:
        """Enables/disables menu items based on selection."""
        has_selection = self._selected_toml_path() is not None
        for mi in (self.mi_edit, self.mi_remove,
                   self.mi_winecfg, self.mi_control,
                   self.mi_taskmgr, self.mi_explorer):
            mi.set_sensitive(has_selection)

    # ---- context menu ----
    def _show_context_menu(self, event) -> None:
        """Shows the right-click context menu."""
        toml_path, data = self._selected_data()
        if toml_path is None or data is None:
            return
        menu = Gtk.Menu()

        item_exec = Gtk.MenuItem(label=tr("EXECUTE"))
        item_exec.connect("activate", partial(self._execute, data=data))
        menu.append(item_exec)

        item_rip = Gtk.MenuItem(label=tr("RUN_IN_PREFIX_TITLE"))
        item_rip.connect("activate", partial(self._run_in_prefix, data=data))
        menu.append(item_rip)

        item_open = Gtk.MenuItem(label=tr("ACT_OPEN"))
        item_open.connect("activate", partial(self._open_prefix, data=data))
        menu.append(item_open)

        menu.show_all()
        menu.popup_at_pointer(event)

    # ---- actions ----
    def _wine_tool_from_selection(self, *_args, tool: str) -> None:
        """Runs a wine tool on the currently selected bubble."""
        _toml_path, data = self._selected_data()
        if data is not None:
            self._run_wine_tool(data, tool)

    def _new_bubble(self, *_args) -> None:
        """Opens the New Bubble dialog."""
        w = AddBubbleDialog(self.app, self)
        w.present()

    def _edit_selected(self, *_args) -> None:
        """Edits the currently selected bubble."""
        p = self._selected_toml_path()
        if p is not None:
            self._edit_path(p)

    def _edit_path(self, toml_path: Path) -> None:
        """Opens the Edit Bubble dialog for a specific TOML."""
        w = AddBubbleDialog(self.app, self, existing_path=toml_path)
        w.present()

    def _remove_selected(self, *_args) -> None:
        """Removes the currently selected bubble."""
        p = self._selected_toml_path()
        if p is not None:
            self._remove_bubble(p)

    def _remove_bubble(self, toml_path: Path) -> None:
        """Opens the Remove Bubble dialog for a specific TOML."""
        data = load_bubble(toml_path)
        if data is None:
            return
        name = data.get("name", toml_path.stem)
        w = RemoveBubbleDialog(self.app, self, toml_path, name)
        w.present()

    def _execute(self, *_args, data: dict) -> None:
        """Executes a bubble's executable."""
        exec_path = (data.get("exec_path") or "").strip()
        if not exec_path:
            self.app.notify(tr("ERROR_TITLE"), tr("NO_EXEC_PATH"))
            return
        if not Path(exec_path).is_file():
            self.app.notify(tr("ERROR_TITLE"), tr("EXEC_PATH_NOT_FOUND", path=exec_path))
            return
        ok, err = launch_with_wine(exec_path, data, notify=self.app.notify)
        if not ok:
            self.app.notify(tr("ERROR_TITLE"), err or tr("SAVE_FAILED"))

    def _run_in_prefix(self, *_args, data: dict) -> None:
        """Opens a dialog to run an arbitrary executable in a bubble's prefix."""
        dialog = Gtk.FileChooserNative(
            title=tr("RUN_IN_PREFIX_TITLE"), transient_for=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )

        def on_response(d, response):
            if response == Gtk.ResponseType.ACCEPT:
                gfile = d.get_file()
                folder = gfile.get_path() if gfile else None
                d.destroy()
                if folder:
                    w = RunInPrefixDialog(self.app, self, data, Path(folder))
                    w.present()
                return
            d.destroy()

        dialog.connect("response", on_response)
        dialog.show()

    def _open_prefix(self, *_args, data: dict) -> None:
        """Opens the bubble's prefix folder in the file manager."""
        prefix_p = resolve_bubble_prefix(data)
        if not prefix_p.exists():
            try:
                prefix_p.mkdir(parents=True, exist_ok=True)
            except Exception as e:
                self.app.notify(
                    tr("ERROR_TITLE"),
                    tr("PREFIX_CREATE_FAILED", path=str(prefix_p), error=str(e)),
                )
                return
        try:
            subprocess.Popen(
                ["xdg-open", str(prefix_p)],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except Exception as e:
            self.app.notify(tr("ERROR_TITLE"), str(e))

    def _run_wine_tool(self, data: dict, tool: str) -> None:
        """Runs a wine tool (winecfg, control, taskmgr, explorer) on a bubble."""
        prefix_p = resolve_bubble_prefix(data)
        wine_cmd = get_wine_local_command()
        if not shutil.which(wine_cmd):
            self.app.notify(tr("ERROR_TITLE"), tr("TOOL_MISSING") + wine_cmd)
            return
        env = dict(os.environ, WINEPREFIX=str(prefix_p))
        print(f'[LWL]: running: WINEPREFIX="{prefix_p}" {wine_cmd} {tool}')
        try:
            subprocess.Popen(
                [wine_cmd, tool], env=env,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except Exception as e:
            self.app.notify(tr("ERROR_TITLE"), str(e))

    def _settings(self) -> None:
        """Opens the settings dialog."""
        w = SettingsDialog(self.app, self)
        w.present()

    def _about(self, *_args) -> None:
        """Opens the About dialog."""
        show_about_dialog(self.app, self)


# ---------- Application ----------
class App(Gtk.Application):
    """Gtk.Application subclass."""

    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.DEFAULT_FLAGS,
        )
        self.main_win: MainWindow | None = None

    def notify(self, title: str, body: str | None = None) -> None:
        """Sends a desktop notification."""
        try:
            n = Gio.Notification.new(title)
            if body:
                n.set_body(body)
            self.send_notification(None, n)
        except Exception as e:
            print(f"[LWL]: notification failed: {e}")
            try:
                cmd = ["notify-send", title]
                if body:
                    cmd.append(body)
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

    def do_activate(self) -> None:
        """Gtk.Application activation hook."""
        if not self.main_win:
            self.main_win = MainWindow(self)
            self.main_win.connect("destroy", partial(self._on_main_destroyed))
        self.main_win.present()

    def _on_main_destroyed(self, *_args) -> None:
        """Callback for main window destruction."""
        self.quit()

    def refresh_main(self) -> None:
        """Refreshes the main window's bubble list."""
        if self.main_win:
            self.main_win.refresh()


def main() -> int:
    """Entry point."""
    setup_directories()
    fix_bubble_paths()
    app = App()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())