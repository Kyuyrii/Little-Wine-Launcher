class RunInPrefixDialog(Gtk.Window):
    # Dialog for executing an arbitrary .exe/.msi inside a bubble's prefix.

    def __init__(self, app: "App", parent: Gtk.Window, data: dict, folder_path: Path):
        self.app = app
        self.data = data
        self.folder_path = Path(folder_path)

        super().__init__(title=tr("RUN_IN_PREFIX_TITLE"))
        self.set_transient_for(parent)
        self.set_modal(True)
        self.set_default_size(420, 360)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        content.set_margin_top(12)
        content.set_margin_bottom(12)
        content.set_margin_start(12)
        content.set_margin_end(12)
        self.add(content)

        self.store = Gtk.ListStore(str, str)
        for path in sorted(self.folder_path.iterdir()):
            if path.is_file() and path.suffix.lower() in (".exe", ".msi"):
                self.store.append([path.name, str(path)])

        self.treeview = None
        if len(self.store) == 0:
            label = Gtk.Label(label=tr("RUN_IN_PREFIX_NO_FILES"))
            label.set_margin_top(24)
            label.set_margin_bottom(24)
            content.pack_start(label, False, False, 0)
        else:
            scroll = Gtk.ScrolledWindow()
            scroll.set_vexpand(True)
            scroll.set_shadow_type(Gtk.ShadowType.NONE)
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            content.pack_start(scroll, True, True, 0)

            self.treeview = Gtk.TreeView(model=self.store)
            self.treeview.set_headers_visible(False)
            self.treeview.connect("row-activated", self._run_selected)

            renderer = Gtk.CellRendererText()
            renderer.set_property("ellipsize", 3)
            col = Gtk.TreeViewColumn("", renderer, text=0)
            col.set_expand(True)
            self.treeview.append_column(col)
            scroll.add(self.treeview)

        action_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        action_bar.set_margin_top(6)
        content.pack_end(action_bar, False, False, 0)

        run_btn = Gtk.Button(label=tr("EXECUTE"))
        run_btn.get_style_context().add_class("suggested-action")
        run_btn.connect("clicked", self._run_selected)
        run_btn.set_sensitive(len(self.store) > 0)
        action_bar.pack_end(run_btn, False, False, 0)

        self.show_all()
        self.present()

    # Returns the selected file's path, or None.
    def _selected_path(self) -> str | None:
        if self.treeview is None:
            return None
        model, treeiter = self.treeview.get_selection().get_selected()
        return model[treeiter][1] if treeiter is not None else None

    # Runs the selected executable with wine.
    def _run_selected(self, *_args) -> None:
        exec_path = self._selected_path()
        if not exec_path:
            return
        ok, err = launch_with_wine(exec_path, self.data, notify=self.app.notify)
        if not ok:
            self.app.notify(tr("ERROR_TITLE"), err or tr("SAVE_FAILED"))


class MainWindow(Gtk.Window):
    # Main application window.

    def __init__(self, app: "App"):
        self.app = app
        super().__init__(title=tr("APP_NAME"))
        self.set_application(app)
        self.set_default_size(520, 580)

        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(self.content)

        self._build_menu()

        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text(tr("SEARCH"))
        self.search_entry.connect("search-changed", self._refilter)
        self.content.pack_start(self.search_entry, False, False, 0)

        self.store = Gtk.ListStore(str, str, str)
        self.filter_model = self.store.filter_new()
        self.filter_model.set_visible_func(self._filter_func)

        self.treeview = Gtk.TreeView(model=self.filter_model)
        self.treeview.set_headers_visible(False)
        self.treeview.set_enable_search(False)
        self.treeview.connect("button-press-event", self._on_tree_button_press)
        self.treeview.connect("row-activated", self._on_row_activated)
        self.treeview.get_selection().connect("changed", self._update_menu_sensitivity)

        icon_renderer = Gtk.CellRendererPixbuf()
        icon_renderer.set_property("xpad", 8)
        icon_renderer.set_property("ypad", 6)
        icon_col = Gtk.TreeViewColumn("", icon_renderer)
        icon_col.set_cell_data_func(icon_renderer, self._icon_data_func)
        self.treeview.append_column(icon_col)

        text_renderer = Gtk.CellRendererText()
        text_renderer.set_property("ellipsize", 3)
        text_renderer.set_property("ypad", 6)
        text_col = Gtk.TreeViewColumn("", text_renderer, text=2)
        text_col.set_expand(True)
        self.treeview.append_column(text_col)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_shadow_type(Gtk.ShadowType.NONE)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.treeview)
        self.content.pack_start(scroll, True, True, 0)

        self._update_menu_sensitivity()
        self.refresh()
        self.show_all()

    def _build_menu(self) -> None:
        menubar = Gtk.MenuBar()
        self.content.pack_start(menubar, False, False, 0)

        def add_menu(label: str) -> Gtk.Menu:
            item = Gtk.MenuItem(label=label)
            menu = Gtk.Menu()
            item.set_submenu(menu)
            menubar.append(item)
            return menu

        def add_item(menu: Gtk.Menu, label: str, handler) -> Gtk.MenuItem:
            item = Gtk.MenuItem(label=label)
            item.connect("activate", handler)
            menu.append(item)
            return item

        bubble_menu = add_menu(tr("MENU_BUBBLE"))
        self.mi_new = add_item(bubble_menu, tr("NEW_BUBBLE"), self._new_bubble)
        self.mi_edit = add_item(bubble_menu, tr("EDIT"), self._edit_selected)
        self.mi_remove = add_item(bubble_menu, tr("REMOVE"), self._remove_selected)

        wine_menu = add_menu(tr("MENU_WINE"))
        self.mi_winecfg = add_item(
            wine_menu, tr("ACT_WINECFG"),
            partial(self._wine_tool_from_selection, tool="winecfg"))
        self.mi_control = add_item(
            wine_menu, tr("ACT_WINE_CONTROL"),
            partial(self._wine_tool_from_selection, tool="control"))
        self.mi_taskmgr = add_item(
            wine_menu, tr("ACT_WINE_TASKMGR"),
            partial(self._wine_tool_from_selection, tool="taskmgr"))
        self.mi_explorer = add_item(
            wine_menu, tr("ACT_WINE_EXPLORER"),
            partial(self._wine_tool_from_selection, tool="explorer"))

        extra_menu = add_menu(tr("MENU_EXTRA"))
        add_item(extra_menu, tr("OPEN_LWL_DIR"), partial(self._open_lwl_dir))
        add_item(extra_menu, tr("UPDATE_SHORTCUTS"), partial(regenerate_shortcuts, self.app))
        add_item(extra_menu, tr("SETTINGS"), partial(self._open_settings))
        extra_menu.append(Gtk.SeparatorMenuItem())
        add_item(extra_menu, tr("ABOUT"), partial(show_about_dialog, self.app, self))

        self._selection_dependent = (
            self.mi_edit, self.mi_remove,
            self.mi_winecfg, self.mi_control,
            self.mi_taskmgr, self.mi_explorer,
        )

    def _on_tree_button_press(self, treeview: Gtk.TreeView, event) -> bool:
        if event.button != 3:
            return False
        path_info = treeview.get_path_at_pos(int(event.x), int(event.y))
        if path_info is None:
            return False
        treeview.get_selection().select_path(path_info[0])
        self._show_context_menu(event)
        return True

    def _on_row_activated(self, treeview: Gtk.TreeView, path, column) -> None:
        model = treeview.get_model()
        data = load_bubble(Path(model[model.get_iter(path)][1]))
        if data:
            self._execute(data=data)

    def _icon_data_func(self, column, cell, model, treeiter, _data) -> None:
        icon_path = model[treeiter][0]
        if icon_path and Path(icon_path).is_file():
            try:
                cell.set_property("pixbuf", GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_path, 64, 64, True))
                return
            except Exception:
                pass
        cell.set_property("pixbuf", None)
        cell.set_property("icon-name", "wine")
        cell.set_property("stock-size", Gtk.IconSize.LARGE_TOOLBAR)

    def _filter_func(self, model, treeiter, _data) -> bool:
        text = self.search_entry.get_text().strip().lower()
        return not text or text in (model[treeiter][2] or "").lower()

    def _refilter(self, *_args) -> None:
        self.filter_model.refilter()

    def refresh(self) -> None:
        self.store.clear()
        for path, data in list_bubbles():
            self.store.append([data.get("gui_path", ""), str(path), data.get("name", path.stem)])
        self._update_menu_sensitivity()

    def _selected_toml_path(self) -> Path | None:
        model, treeiter = self.treeview.get_selection().get_selected()
        return Path(model[treeiter][1]) if treeiter is not None else None

    def _selected_data(self) -> tuple[Path | None, dict | None]:
        p = self._selected_toml_path()
        return (p, load_bubble(p)) if p is not None else (None, None)

    def _update_menu_sensitivity(self, *_args) -> None:
        has_selection = self._selected_toml_path() is not None
        for mi in self._selection_dependent:
            mi.set_sensitive(has_selection)

    def _show_context_menu(self, event) -> None:
        toml_path, data = self._selected_data()
        if toml_path is None or data is None:
            return
        menu = Gtk.Menu()
        for label, handler in (
            (tr("EXECUTE"), partial(self._execute, data=data)),
            (tr("RUN_IN_PREFIX_TITLE"), partial(self._run_in_prefix, data=data)),
            (tr("ACT_OPEN"), partial(self._open_prefix, data=data)),
        ):
            item = Gtk.MenuItem(label=label)
            item.connect("activate", handler)
            menu.append(item)
        menu.show_all()
        menu.popup_at_pointer(event)

    def _wine_tool_from_selection(self, *_args, tool: str) -> None:
        _toml_path, data = self._selected_data()
        if data is not None:
            self._run_wine_tool(data, tool)

    def _new_bubble(self, *_args) -> None:
        AddBubbleDialog(self.app, self).present()

    def _edit_selected(self, *_args) -> None:
        p = self._selected_toml_path()
        if p is not None:
            AddBubbleDialog(self.app, self, existing_path=p).present()

    def _remove_selected(self, *_args) -> None:
        p = self._selected_toml_path()
        if p is not None:
            data = load_bubble(p)
            if data is not None:
                show_remove_bubble_dialog(self.app, self, p, data.get("name", p.stem))

    def _execute(self, *_args, data: dict) -> None:
        exec_path = (data.get("exec_path") or "").strip()
        if not exec_path:
            self.app.notify(tr("ERROR_TITLE"), tr("NO_EXEC_PATH"))
            return
        if not Path(exec_path).is_file():
            self.app.notify(tr("ERROR_TITLE"), tr("EXEC_PATH_NOT_FOUND", path=exec_path))
            return
        ok, err = launch_with_wine(exec_path, data, notify=self.app.notify)
        if not ok:
            self.app.notify(tr("ERROR_TITLE"), err or tr("SAVE_FAILED"))

    def _run_in_prefix(self, *_args, data: dict) -> None:
        def on_accept(folder: str) -> None:
            RunInPrefixDialog(self.app, self, data, Path(folder)).present()

        open_file_chooser(
            self, tr("RUN_IN_PREFIX_TITLE"), on_accept=on_accept,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )

    def _open_prefix(self, *_args, data: dict) -> None:
        self._xdg_open(resolve_bubble_prefix(data))

    def _open_lwl_dir(self, *_args) -> None:
        self._xdg_open(lwl_dir)

    def _xdg_open(self, path: Path) -> None:
        try:
            path.mkdir(parents=True, exist_ok=True)
        except Exception as e:
            self.app.notify(tr("ERROR_TITLE"), tr("PREFIX_CREATE_FAILED", path=str(path), error=str(e)))
            return
        xdg_open(path)

    def _run_wine_tool(self, data: dict, tool: str) -> None:
        prefix_p = resolve_bubble_prefix(data)
        if not shutil.which("wine"):
            self.app.notify(tr("ERROR_TITLE"), tr("TOOL_MISSING") + "wine")
            return
        env = dict(os.environ, WINEPREFIX=str(prefix_p))
        print(f'[LWL]: running: WINEPREFIX="{prefix_p}" wine {tool}')
        try:
            subprocess.Popen(
                ["wine", tool], env=env,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except Exception as e:
            self.app.notify(tr("ERROR_TITLE"), str(e))

    def _open_settings(self, *_args) -> None:
        SettingsDialog(self.app, self).present()


class App(Gtk.Application):
    # Gtk.Application subclass.

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.main_win: MainWindow | None = None

    # Sends a desktop notification.
    def notify(self, title: str, body: str | None = None) -> None:
        try:
            n = Gio.Notification.new(title)
            if body:
                n.set_body(body)
            self.send_notification(None, n)
        except Exception as e:
            print(f"[LWL]: notification failed: {e}")
            try:
                cmd = ["notify-send", title] + ([body] if body else [])
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

    def do_activate(self) -> None:
        if not self.main_win:
            self.main_win = MainWindow(self)
            self.main_win.connect("destroy", self._on_main_destroyed)
        self.main_win.present()

    def _on_main_destroyed(self, *_args) -> None:
        self.quit()

    # Refreshes the main window's bubble list.
    def refresh_main(self) -> None:
        if self.main_win:
            self.main_win.refresh()


# Entry point.
def main() -> int:
    setup_directories()
    fix_bubble_paths()
    return App().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())