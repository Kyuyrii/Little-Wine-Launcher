    def _label_with_widget(self, text: str, widget: Gtk.Widget) -> Gtk.Box:
        """Returns a horizontal row with a label and a widget."""
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.pack_start(Gtk.Label(label=text, xalign=0), True, True, 0)
        widget.set_hexpand(False)
        row.pack_end(widget, False, False, 0)
        return row

    def _on_name_changed(self, *_args) -> None:
        """Callback for name entry changes (autofills prefix)."""
        self._autofill_prefix()

    def _autofill_prefix(self) -> None:
        """Autofills the prefix entry based on the current name."""
        name = self.name_entry.get_text().strip()
        if not name:
            return
        self.prefix_entry.set_text(str(lwl_bubble_dir / bubble_safe_name(name)))

    def _populate_from_existing(self) -> None:
        """Fills form fields from the existing bubble data."""
        d = self.existing_data
        self.exec_entry.set_text(d.get("exec_path", ""))
        self.prefix_entry.set_text(d.get("prefix_path", ""))
        self.icon_entry.set_text(d.get("gui_path", ""))
        self.desktop_switch.set_active(bool(d.get("desktop_shortcut", False)))
        self.menu_switch.set_active(bool(d.get("menu_shortcut", False)))
        loc = d.get("language", "")
        if loc in LWL_LOCALES:
            self.locale_combo.set_active(LWL_LOCALES.index(loc) + 1)
        else:
            self.locale_combo.set_active(0)
        cat = d.get("category", "")
        if cat in LWL_CATEGORIES:
            self.category_combo.set_active(LWL_CATEGORIES.index(cat))
        else:
            self.category_combo.set_active(0)

    def _browse_exec(self, *_args) -> None:
        """Opens a file chooser for the executable."""
        dialog = Gtk.FileChooserNative(
            title=tr("FIELD_EXEC"), transient_for=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        # Start in the prefix folder if set, otherwise in the default Wine prefix
        start_dir = None
        prefix_text = self.prefix_entry.get_text().strip()
        if prefix_text:
            p = Path(prefix_text)
            drive_c = p / "drive_c"
            if drive_c.is_dir():
                start_dir = drive_c
            elif p.is_dir():
                start_dir = p
        else:
            default_drive_c = lwl_dot_wine / "drive_c"
            if default_drive_c.is_dir():
                start_dir = default_drive_c
        if start_dir is not None:
            dialog.set_current_folder(str(start_dir))
        f = Gtk.FileFilter()
        f.set_name(tr("FILTER_EXECUTABLES"))
        f.add_pattern("*.exe")
        f.add_pattern("*.msi")
        dialog.add_filter(f)
        f2 = Gtk.FileFilter()
        f2.set_name(tr("FILTER_ALL_FILES"))
        f2.add_pattern("*")
        dialog.add_filter(f2)
        dialog.connect("response", partial(self._on_file_chooser_response, entry=self.exec_entry))
        dialog.show()

    def _browse_prefix(self, *_args) -> None:
        """Opens a folder chooser for the prefix."""
        dialog = Gtk.FileChooserNative(
            title=tr("FIELD_PREFIX"), transient_for=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dialog.connect("response", partial(self._on_file_chooser_response, entry=self.prefix_entry))
        dialog.show()

    def _browse_icon(self, *_args) -> None:
        """Opens a file chooser for the icon."""
        dialog = Gtk.FileChooserNative(
            title=tr("FIELD_ICON"), transient_for=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        f = Gtk.FileFilter()
        f.set_name(tr("FILTER_IMAGES"))
        for pat in ("*.png", "*.jpg", "*.jpeg", "*.ico", "*.svg"):
            f.add_pattern(pat)
        dialog.add_filter(f)
        f2 = Gtk.FileFilter()
        f2.set_name(tr("FILTER_ALL_FILES"))
        f2.add_pattern("*")
        dialog.add_filter(f2)
        dialog.connect("response", partial(self._on_file_chooser_response, entry=self.icon_entry))
        dialog.show()

    def _on_file_chooser_response(self, dialog: Gtk.FileChooserNative, response: int, entry: Gtk.Entry) -> None:
        """Generic callback for file chooser responses."""
        if response == Gtk.ResponseType.ACCEPT:
            gfile = dialog.get_file()
            if gfile:
                path = gfile.get_path()
                if path:
                    entry.set_text(path)
        dialog.destroy()

    def _error(self, msg: str) -> None:
        """Shows an error dialog."""
        dlg = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=tr("ERROR_TITLE"),
        )
        dlg.format_secondary_text(msg)
        dlg.run()
        dlg.destroy()

    def on_save(self, *_args) -> None:
        """Validates and saves the bubble."""
        name = self.name_entry.get_text().strip()
        if not name:
            self._error(tr("NAME_REQUIRED"))
            return

        safe_name = bubble_safe_name(name)
        target = bubble_file_path(name)

        if not self.is_edit and target.exists():
            self._error(tr("BUBBLE_ALREADY_EXISTS", name=name))
            return

        exec_path = self.exec_entry.get_text().strip()
        prefix_path = self.prefix_entry.get_text().strip()

        loc_idx = self.locale_combo.get_active()
        language = "" if loc_idx <= 0 else LWL_LOCALES[loc_idx - 1]

        cat_idx = self.category_combo.get_active()
        category = LWL_CATEGORIES[cat_idx] if cat_idx >= 0 else ""

        user_icon = self.icon_entry.get_text().strip()

        if prefix_path:
            try:
                Path(prefix_path).mkdir(parents=True, exist_ok=True)
            except Exception:
                pass

        gui_path = install_icon_for_bubble(safe_name, user_icon, exec_path)
        remove_icon_for_bubble(safe_name, keep_path=gui_path)

        data = {
            "name": name,
            "exec_path": exec_path,
            "prefix_path": prefix_path,
            "gui_path": gui_path,
            "language": language,
            "category": category,
            "desktop_shortcut": self.desktop_switch.get_active(),
            "menu_shortcut": self.menu_switch.get_active(),
        }

        if self.is_edit:
            target = self.existing_path

        if not save_bubble(target, data):
            self._error(tr("SAVE_FAILED"))
            return

        self.destroy()
        self.app.refresh_main()


