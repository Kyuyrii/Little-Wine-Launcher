    for p in lwl_gui_dir.glob(f"{safe_name}.*"):
        if keep_path is not None and str(p) == str(keep_path):
            continue
        try:
            p.unlink()
        except Exception:
            pass


# Resolves a bubble's WINEPREFIX.
def resolve_bubble_prefix(data: dict) -> Path:
    prefix = (data.get("prefix_path") or "").strip()
    return Path(prefix) if prefix else lwl_dot_wine


# Builds the environment dict for launching a bubble.
def build_env_for_bubble(data: dict) -> dict:
    env = os.environ.copy()
    prefix = (data.get("prefix_path") or "").strip()
    if prefix:
        env["WINEPREFIX"] = prefix
    language = (data.get("language") or "").strip()
    if language:
        env["LC_ALL"] = language
        env["LANG"] = language
        env["LANGUAGE"] = language
    return env


# Launches a bubble's executable with wine. Returns (ok, error).
def launch_with_wine(exec_path: str, data: dict, notify=None) -> tuple[bool, str | None]:
    if not shutil.which("wine"):
        return False, tr("TOOL_MISSING") + "wine"
    env = build_env_for_bubble(data)
    cwd = str(Path(exec_path).parent) if exec_path else None

    env_prefix = [
        f'{k}="{env[k]}"'
        for k in ("WINEPREFIX", "LC_ALL", "LANG", "LANGUAGE")
        if k in env and env[k] != os.environ.get(k)
    ]
    logged_cmd = " ".join(env_prefix + ["wine", f'"{exec_path}"'])
    print(f"[LWL]: running: {logged_cmd}")

    try:
        subprocess.Popen(
            ["wine", str(exec_path)], env=env, cwd=cwd,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if notify is not None:
            notify(tr("APP_NAME"), tr("RUNNING_WINE"))
        return True, None
    except Exception as e:
        return False, str(e)


# Builds the Exec= line for a .desktop file.
def build_exec_line(data: dict) -> str:
    env_parts = []
    prefix = (data.get("prefix_path") or "").strip()
    if prefix:
        env_parts.append(f'WINEPREFIX="{prefix}"')
    language = (data.get("language") or "").strip()
    if language:
        env_parts += [f"LC_ALL={language}", f"LANG={language}", f"LANGUAGE={language}"]
    exec_path = (data.get("exec_path") or "").strip()

    parts = (["env"] + env_parts) if env_parts else []
    parts += [WINE_DESKTOP_CMD, f'"{exec_path}"']
    return " ".join(parts)


# Writes a .desktop file for a bubble; returns the path or None.
def write_desktop_for_bubble(data: dict, folder: Path) -> Path | None:
    safe_name = bubble_safe_name(data.get("name", ""))
    if not safe_name:
        return None
    folder = Path(folder)
    try:
        folder.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        print(f"[LWL]: failed to create {folder}: {e}")
        return None

    name = data.get("name", "")
    exec_path = data.get("exec_path", "")
    icon_path = data.get("gui_path", "") or "wine"
    category = data.get("category", "") or "Utility"

    lines = [
        "[Desktop Entry]",
        f"Name={name}",
        f"Exec={build_exec_line(data)}",
        f"Icon={icon_path}",
    ]
    if exec_path:
        lines.append(f"Path={Path(exec_path).parent}")
        lines.append(f"StartupWMClass={Path(exec_path).name}")
    lines += [
        f"Categories={category};",
        "Type=Application",
        "StartupNotify=false",
        "Terminal=false",
    ]
    desktop_file = folder / f"bubble-{safe_name}.desktop"
    try:
        with open(desktop_file, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        os.chmod(desktop_file, 0o755)
        return desktop_file
    except Exception as e:
        print(f"[LWL]: failed to write {desktop_file}: {e}")
        return None


# Removes a bubble's .desktop file from a folder.
def remove_bubble_desktop(folder: Path, safe_name: str) -> None:
    f = Path(folder) / f"bubble-{safe_name}.desktop"
    if f.is_file():
        try:
            f.unlink()
        except Exception as e:
            print(f"[LWL]: failed to remove {f}: {e}")


# Regenerates all .desktop shortcuts from saved bubbles.
def regenerate_shortcuts(app: "App", *_args) -> None:
    desktop_dir, applications_dir = get_shortcut_dirs()
    try:
        desktop_dir.mkdir(parents=True, exist_ok=True)
        applications_dir.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        app.notify(tr("ERROR_TITLE"), tr("ERROR_CREATING_SHORTCUTS_LOCATION", path=str(e)))
        return
    for _path, data in list_bubbles():
        safe_name = bubble_safe_name(data.get("name", ""))
        for folder, key in ((desktop_dir, "desktop_shortcut"),
                            (applications_dir, "menu_shortcut")):
            if data.get(key, False):
                write_desktop_for_bubble(data, folder)
            else:
                remove_bubble_desktop(folder, safe_name)
    print("[LWL]: shortcuts updated.")
    app.notify(tr("UPDATE_SHORTCUTS"), tr("SHORTCUTS_UPDATED"))


# Shows a GTK message dialog; returns the response.
def show_message(parent: Gtk.Window, mtype: Gtk.MessageType, text: str,
                 secondary: str | None = None,
                 buttons=Gtk.ButtonsType.OK) -> int:
    dlg = Gtk.MessageDialog(
        transient_for=parent, modal=True,
        message_type=mtype, buttons=buttons, text=text,
    )
    if secondary:
        dlg.format_secondary_text(secondary)
    response = dlg.run()
    dlg.destroy()
    return response


# Opens a native file chooser; calls on_accept(path) on success.
def open_file_chooser(parent: Gtk.Window, title: str, on_accept,
                      action=Gtk.FileChooserAction.OPEN,
                      filters: list[Gtk.FileFilter] | None = None,
                      start_dir: Path | None = None) -> None:
    dialog = Gtk.FileChooserNative(title=title, transient_for=parent, action=action)
    if start_dir:
        dialog.set_current_folder(str(start_dir))
    for f in (filters or []):
        dialog.add_filter(f)

    def on_response(d, response):
        if response == Gtk.ResponseType.ACCEPT:
            gfile = d.get_file()
            path = gfile.get_path() if gfile else None
            if path:
                on_accept(path)
        d.destroy()

    dialog.connect("response", on_response)
    dialog.show()


# Builds a GTK file filter.
def make_filter(name: str, patterns: list[str]) -> Gtk.FileFilter:
    f = Gtk.FileFilter()
    f.set_name(name)
    for pat in patterns:
        f.add_pattern(pat)
    return f


# Opens a path in the user's file manager.
def xdg_open(path: Path) -> None:
    try:
        subprocess.Popen(
            ["xdg-open", str(path)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        print(f"[LWL]: xdg-open failed: {e}")


