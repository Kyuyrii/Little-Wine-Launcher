        else:
            self.name_entry.connect("changed", self._autofill_prefix)
        box.pack_start(self.name_entry, False, False, 0)

        box.pack_start(Gtk.Label(label=tr("FIELD_EXEC"), xalign=0), False, False, 0)
        self.exec_entry = self._entry_row(box, self._browse_exec)

        box.pack_start(Gtk.Label(label=tr("FIELD_PREFIX"), xalign=0), False, False, 0)
        self.prefix_entry = self._entry_row(box, self._browse_prefix)

        box.pack_start(Gtk.Label(label=tr("FIELD_ICON"), xalign=0), False, False, 0)
        self.icon_entry = self._entry_row(box, self._browse_icon)

        box.pack_start(Gtk.Label(label=tr("FIELD_LOCALE"), xalign=0), False, False, 0)
        self.locale_combo = Gtk.ComboBoxText()
        self.locale_combo.append_text(tr("INDEFINITE"))
        for loc in LWL_LOCALES:
            self.locale_combo.append_text(loc)
        self.locale_combo.set_active(0)
        box.pack_start(self.locale_combo, False, False, 0)

        box.pack_start(Gtk.Label(label=tr("FIELD_XDG_CATEGORY"), xalign=0), False, False, 0)
        self.category_combo = Gtk.ComboBoxText()
        for cat in LWL_CATEGORIES:
            self.category_combo.append_text(cat)
        self.category_combo.set_active(0)
        box.pack_start(self.category_combo, False, False, 0)

        box.pack_start(Gtk.Label(label=tr("SHORTCUTS"), xalign=0), False, False, 0)
        self.desktop_switch = Gtk.Switch()
        box.pack_start(
            self._label_with_widget(tr("SHORTCUT_ON_DESKTOP"), self.desktop_switch),
            False, False, 0,
        )
        self.menu_switch = Gtk.Switch()
        box.pack_start(
            self._label_with_widget(tr("SHORTCUT_ON_MENU"), self.menu_switch),
            False, False, 0,
        )

        if self.is_edit:
            self._populate_from_existing()
        else:
            self._autofill_prefix()

        self.show_all()
        self.present()

    # Creates a label + entry + browse-button row and returns the entry.
    def _entry_row(self, box: Gtk.Box, browse_cb) -> Gtk.Entry:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        entry = Gtk.Entry()
        row.pack_start(entry, True, True, 0)
        btn = Gtk.Button.new_from_icon_name("document-open-symbolic", Gtk.IconSize.BUTTON)
        btn.connect("clicked", browse_cb)
        row.pack_start(btn, False, False, 0)
        box.pack_start(row, False, False, 0)
        return entry

    # Returns a horizontal row with a label and a widget.
    def _label_with_widget(self, text: str, widget: Gtk.Widget) -> Gtk.Box:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.pack_start(Gtk.Label(label=text, xalign=0), True, True, 0)
        widget.set_hexpand(False)
        row.pack_end(widget, False, False, 0)
        return row

    # Autofills the prefix entry based on the current name.
    def _autofill_prefix(self, *_args) -> None:
        name = self.name_entry.get_text().strip()
        if name:
            self.prefix_entry.set_text(str(lwl_bubble_dir / bubble_safe_name(name)))

    # Fills form fields from the existing bubble data.
    def _populate_from_existing(self) -> None:
        d = self.existing_data
        self.exec_entry.set_text(d.get("exec_path", ""))
        self.prefix_entry.set_text(d.get("prefix_path", ""))
        self.icon_entry.set_text(d.get("gui_path", ""))
        self.desktop_switch.set_active(bool(d.get("desktop_shortcut", False)))
        self.menu_switch.set_active(bool(d.get("menu_shortcut", False)))
        loc = d.get("language", "")
        self.locale_combo.set_active(LWL_LOCALES.index(loc) + 1 if loc in LWL_LOCALES else 0)
        cat = d.get("category", "")
        self.category_combo.set_active(LWL_CATEGORIES.index(cat) if cat in LWL_CATEGORIES else 0)

    # Opens a file chooser for the executable.
    def _browse_exec(self, *_args) -> None:
        start_dir = None
        prefix_text = self.prefix_entry.get_text().strip()
        base = Path(prefix_text) if prefix_text else lwl_dot_wine
        for cand in (base / "drive_c", base):
            if cand.is_dir():
                start_dir = cand
                break
        open_file_chooser(
            self, tr("FIELD_EXEC"),
            on_accept=self.exec_entry.set_text,
            filters=[
                make_filter(tr("FILTER_EXECUTABLES"), ["*.exe", "*.msi"]),
                make_filter(tr("FILTER_ALL_FILES"), ["*"]),
            ],
            start_dir=start_dir,
        )

    # Opens a folder chooser for the prefix.
    def _browse_prefix(self, *_args) -> None:
        open_file_chooser(
            self, tr("FIELD_PREFIX"),
            on_accept=self.prefix_entry.set_text,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )

    # Opens a file chooser for the icon.
    def _browse_icon(self, *_args) -> None:
        open_file_chooser(
            self, tr("FIELD_ICON"),
            on_accept=self.icon_entry.set_text,
            filters=[
                make_filter(tr("FILTER_IMAGES"), ["*.png", "*.jpg", "*.jpeg", "*.ico", "*.svg"]),
                make_filter(tr("FILTER_ALL_FILES"), ["*"]),
            ],
        )

    # Shows an error dialog.
    def _error(self, msg: str) -> None:
        show_message(self, Gtk.MessageType.ERROR, tr("ERROR_TITLE"), msg)

    # Validates and saves the bubble.
    def on_save(self, *_args) -> None:
        name = self.name_entry.get_text().strip()
        err_key = _validate_bubble_name(name)
        if err_key:
            self._error(tr(err_key))
            return

        safe_name = bubble_safe_name(name)
        target = bubble_file_path(name)
        if not self.is_edit and target.exists():
            self._error(tr("BUBBLE_ALREADY_EXISTS", name=name))
            return

        exec_path = self.exec_entry.get_text().strip()
        prefix_path = self.prefix_entry.get_text().strip()
        loc_idx = self.locale_combo.get_active()
        language = "" if loc_idx <= 0 else LWL_LOCALES[loc_idx - 1]
        cat_idx = self.category_combo.get_active()
        category = LWL_CATEGORIES[cat_idx] if cat_idx >= 0 else ""
        user_icon = self.icon_entry.get_text().strip()

        if prefix_path:
            try:
                Path(prefix_path).mkdir(parents=True, exist_ok=True)
            except Exception:
                pass

        gui_path = install_icon_for_bubble(safe_name, user_icon, exec_path)
        remove_icon_for_bubble(safe_name, keep_path=gui_path)

        data = {
            "name": name,
            "exec_path": exec_path,
            "prefix_path": prefix_path,
            "gui_path": gui_path,
            "language": language,
            "category": category,
            "desktop_shortcut": self.desktop_switch.get_active(),
            "menu_shortcut": self.menu_switch.get_active(),
        }

        if self.is_edit:
            target = self.existing_path

        try:
            if not save_bubble(target, data):
                raise RuntimeError("save_bubble returned False")
        except Exception as e:
            print(f"[LWL]: failed to save bubble: {e}")
            self._error(tr("SAVE_FAILED"))
            return

        self.destroy()
        self.app.refresh_main()


