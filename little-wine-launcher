class RunInPrefixDialog(Gtk.Window):
    """Dialog for executing an arbitrary .exe/.msi inside a bubble's prefix."""

    def __init__(self, app: "App", parent: Gtk.Window, data: dict, folder_path: Path):
        self.app = app
        self.data = data
        self.folder_path = Path(folder_path)

        super().__init__(title=tr("RUN_IN_PREFIX_TITLE"))
        self.set_transient_for(parent)
        self.set_modal(True)
        self.set_default_size(420, 360)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        content.set_margin_top(12)
        content.set_margin_bottom(12)
        content.set_margin_start(12)
        content.set_margin_end(12)
        self.add(content)

        self.store = Gtk.ListStore(str, str)
        for path in sorted(self.folder_path.iterdir()):
            if path.is_file() and path.suffix.lower() in (".exe", ".msi"):
                self.store.append([path.name, str(path)])

        self.treeview = None
        if len(self.store) == 0:
            label = Gtk.Label(label=tr("RUN_IN_PREFIX_NO_FILES"))
            label.set_margin_top(24)
            label.set_margin_bottom(24)
            content.pack_start(label, False, False, 0)
        else:
            scroll = Gtk.ScrolledWindow()
            scroll.set_vexpand(True)
            scroll.set_shadow_type(Gtk.ShadowType.NONE)
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            content.pack_start(scroll, True, True, 0)

            self.treeview = Gtk.TreeView(model=self.store)
            self.treeview.set_headers_visible(False)
            self.treeview.connect("row-activated", partial(self._on_row_activated))

            text_renderer = Gtk.CellRendererText()
            text_renderer.set_property("ellipsize", 3)
            text_col = Gtk.TreeViewColumn("", text_renderer, text=0)
            text_col.set_expand(True)
            self.treeview.append_column(text_col)

            scroll.add(self.treeview)

        action_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        action_bar.set_margin_top(6)
        content.pack_end(action_bar, False, False, 0)

        run_btn = Gtk.Button(label=tr("EXECUTE"))
        run_btn.get_style_context().add_class("suggested-action")
        run_btn.connect("clicked", partial(self._run_selected))
        run_btn.set_sensitive(len(self.store) > 0)
        action_bar.pack_end(run_btn, False, False, 0)

        self.show_all()
        self.present()

    def _on_row_activated(self, *_args) -> None:
        """Callback when a row is activated."""
        self._run_selected()

    def _selected_path(self) -> str | None:
        """Returns the selected file's path, or None."""
        if self.treeview is None:
            return None
        model, treeiter = self.treeview.get_selection().get_selected()
        if treeiter is None:
            return None
        return model[treeiter][1]

    def _run_selected(self, *_args) -> None:
        """Runs the selected executable with wine."""
        exec_path = self._selected_path()
        if not exec_path:
            return
        ok, err = launch_with_wine(exec_path, self.data, notify=self.app.notify)
        if not ok:
            self.app.notify(tr("ERROR_TITLE"), err or tr("SAVE_FAILED"))


