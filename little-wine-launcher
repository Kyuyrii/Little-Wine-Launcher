        action_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        action_bar.set_margin_top(6)
        content.pack_start(action_bar, False, False, 0)

        save_btn = Gtk.Button(label=tr("SAVE"))
        save_btn.get_style_context().add_class("suggested-action")
        save_btn.connect("clicked", partial(self._save))
        action_bar.pack_end(save_btn, False, False, 0)

        self.show_all()
        self.present()

    def _browse(self, _button: Gtk.Button, entry: Gtk.Entry) -> None:
        """Opens a folder chooser and puts the result in `entry`."""
        dialog = Gtk.FileChooserNative(
            title=tr("SETTINGS"), transient_for=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )

        def on_response(d, response):
            if response == Gtk.ResponseType.ACCEPT:
                gfile = d.get_file()
                if gfile:
                    path = gfile.get_path()
                    if path:
                        entry.set_text(path)
            d.destroy()

        dialog.connect("response", on_response)
        dialog.show()

    def _save(self, *_args) -> None:
        """Saves settings."""
        settings = load_settings()
        idx = self.lang_combo.get_active()
        new_lang = self.lang_codes[idx] if idx >= 0 else "en_US"
        settings.setdefault("design", {})
        settings["design"]["language"] = new_lang
        settings.setdefault("shortcut", {})
        settings["shortcut"]["desktop_dir"] = self.desktop_entry.get_text().strip()
        settings["shortcut"]["applications_dir"] = self.applications_entry.get_text().strip()
        save_settings(settings)
        self.destroy()


