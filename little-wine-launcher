def tr(key: str, **kwargs) -> str:
    """Returns the translated string for the given key."""
    if LANG in available_translations:
        d = available_translations[LANG]
        s = d.get(key)
        if s:
            s = s.replace("{__version__}", __version__)
            s = s.replace("{__creator__}", __creator__)
            try:
                return s.format(**kwargs)
            except (KeyError, ValueError):
                return s
    return key


# ---------- File helpers ----------
def bubble_safe_name(name: str) -> str:
    """Normalizes a bubble name for filesystem use."""
    return name.replace(" ", "_").lower()


def bubble_file_path(name: str) -> Path:
    """Returns the TOML path for a given bubble name."""
    return lwl_config_dir / f"bubble-{bubble_safe_name(name)}.toml"


def load_bubble(path: Path) -> dict | None:
    """Loads a bubble TOML file; returns None on failure."""
    try:
        import tomlkit
        with open(path, "r", encoding="utf-8") as f:
            return dict(tomlkit.load(f))
    except Exception as e:
        print(f"[LWL]: failed to load {path}: {e}")
        return None


def save_bubble(path: Path, data: dict) -> bool:
    """Saves a bubble dict to TOML."""
    try:
        import tomlkit
        with open(path, "w", encoding="utf-8") as f:
            tomlkit.dump(data, f)
        return True
    except Exception as e:
        print(f"[LWL]: failed to save {path}: {e}")
        return False


def list_bubbles() -> list[tuple[Path, dict]]:
    """Lists all bubbles as (path, data) tuples."""
    result: list[tuple[Path, dict]] = []
    if not lwl_config_dir.is_dir():
        return result
    for path in sorted(lwl_config_dir.glob("bubble-*.toml")):
        data = load_bubble(path)
        if data is not None:
            result.append((path, data))
    return result


def fix_bubble_paths() -> None:
    """Fixes paths in all bubble TOMLs if they reference an outdated base dir."""
    current_base = str(lwl_home_dir)
    if not lwl_config_dir.exists():
        return

    for toml_file in lwl_config_dir.glob("bubble-*.toml"):
        try:
            with open(toml_file, "r+", encoding="utf-8") as f:
                import tomlkit
                data = tomlkit.load(f)
                modified = False

                for field in ("exec_path", "prefix_path", "gui_path"):
                    if field in data and "/App/Little-Wine-Launcher/" in str(data[field]):
                        old_base = str(data[field]).split("/App/Little-Wine-Launcher/")[0]
                        if old_base != current_base:
                            data[field] = str(data[field]).replace(old_base, current_base, 1)
                            modified = True

                if modified:
                    f.seek(0)
                    tomlkit.dump(data, f)
                    f.truncate()
        except Exception:
            continue


# ---------- Shortcut directory helpers ----------
def get_default_desktop_dir() -> Path:
    """Returns the user's XDG desktop directory."""
    desktop_dir = Path.home() / "Desktop"
    user_dirs_file = Path.home() / ".config" / "user-dirs.dirs"
    if user_dirs_file.is_file():
        try:
            with open(user_dirs_file, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("XDG_DESKTOP_DIR"):
                        path = line.split("=", 1)[1].strip().strip('"')
                        path = path.replace("$HOME", str(Path.home()))
                        desktop_dir = Path(path)
                        break
        except Exception:
            pass
    return desktop_dir


def get_default_applications_dir() -> Path:
    """Returns the default .local/share/applications directory."""
    return Path.home() / ".local" / "share" / "applications"


def get_shortcut_dirs() -> tuple[Path, Path]:
    """Returns (desktop_dir, applications_dir) from settings or defaults."""
    settings = load_settings()
    section = settings.get("shortcut", {})
    desktop_dir = section.get("desktop_dir", "") or str(get_default_desktop_dir())
    applications_dir = section.get("applications_dir", "") or str(get_default_applications_dir())
    return Path(desktop_dir), Path(applications_dir)


# ---------- Icon helpers ----------
def get_largest_icon_size(ico_file: Path) -> int:
    """Returns the largest icon size available in an .ico file."""
    max_size = 0
    try:
        out = subprocess.run(
            ["icotool", "-l", str(ico_file)],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except Exception:
        return 0
    import re
    for line in out.splitlines():
        m = re.search(r"--width=(\d+)", line)
        if m:
            size = int(m.group(1))
            if size > max_size:
                max_size = size
    return max_size


def extract_exe_icon(exe_path: str, out_png: Path) -> bool:
    """Extracts the largest icon from an .exe using wrestool+icotool."""
    if not shutil.which("wrestool") or not shutil.which("icotool"):
        return False
    cache = Path(tempfile.mkdtemp())
    try:
        ico = cache / "temp.ico"
        with open(ico, "wb") as f:
            r = subprocess.run(
                ["wrestool", "-x", "-t", "14", str(exe_path)],
                stdout=f, stderr=subprocess.DEVNULL, timeout=30,
            )
        if r.returncode != 0 or ico.stat().st_size == 0:
            return False
        size = get_largest_icon_size(ico)
        if size <= 0:
            return False
        r = subprocess.run(
            ["icotool", "-x", "-w", str(size), "-h", str(size),
             "-o", str(cache), str(ico)],
            capture_output=True, timeout=30,
        )
        if r.returncode != 0:
            return False
        pngs = list(cache.glob("*.png"))
        if not pngs:
            return False
        shutil.copy(pngs[0], out_png)
        return True
    except Exception:
        return False
    finally:
        shutil.rmtree(cache, ignore_errors=True)


def extract_ico_png(ico_path: Path, out_png: Path) -> bool:
    """Extracts the largest image from an .ico file as PNG."""
    if not shutil.which("icotool"):
        return False
    cache = Path(tempfile.mkdtemp())
    try:
        subprocess.run(
            ["icotool", "-x", str(ico_path)],
            capture_output=True, timeout=30, cwd=str(cache),
        )
        pngs = list(cache.glob("*.png"))
        if not pngs:
            return False
        import re
        best = None
        best_area = -1
        for png in pngs:
            m = re.search(r"_(\d+)x(\d+)x\d+\.png$", png.name)
            area = (int(m.group(1)) * int(m.group(2))) if m else 0
            if area > best_area:
                best = png
                best_area = area
        if best is None:
            best = pngs[0]
        shutil.copy(best, out_png)
        return True
    except Exception as e:
        print(f"[LWL]: extract_ico_png error: {e}")
        return False
    finally:
        shutil.rmtree(cache, ignore_errors=True)


def install_icon_for_bubble(safe_name: str, source_path: str, exe_path: str) -> str:
    """Installs (or extracts) an icon for a bubble; returns the installed path."""
    lwl_gui_dir.mkdir(parents=True, exist_ok=True)
    if source_path:
        src = Path(source_path)
        if src.is_file():
            if src.suffix.lower() == ".ico":
                dst = lwl_gui_dir / f"{safe_name}.png"
                if extract_ico_png(src, dst):
                    return str(dst)
            else:
                dst = lwl_gui_dir / f"{safe_name}{src.suffix.lower()}"
                try:
                    shutil.copyfile(src, dst)
                    return str(dst)
                except Exception:
                    pass
    if exe_path:
        dst = lwl_gui_dir / f"{safe_name}.png"
        if extract_exe_icon(exe_path, dst):
            return str(dst)
    return "wine"


def remove_icon_for_bubble(safe_name: str, keep_path: str | None = None) -> None:
    """Removes all icon files matching a bubble's safe name."""
    if not lwl_gui_dir.is_dir():
        return
    for p in lwl_gui_dir.glob(f"{safe_name}.*"):
        if keep_path is not None and str(p) == str(keep_path):
            continue
        try:
            p.unlink()
        except Exception:
            pass


# ---------- Wine command helpers ----------
def get_wine_desktop_command() -> str:
    """Returns the wine command appropriate for the packaging context."""
    if os.environ.get("SNAP"):
        return "snap run winehq-stable"
    if os.environ.get("container") == "flatpak":
        return "flatpak run --command=wine io.github.kyuyrii.little-wine-launcher"
    return "wine"


def get_wine_local_command() -> str:
    """Returns the local wine command."""
    return "wine"


def resolve_bubble_prefix(data: dict) -> Path:
    """Resolves a bubble's WINEPREFIX."""
    prefix = (data.get("prefix_path") or "").strip()
    if prefix:
        return Path(prefix)
    return lwl_dot_wine


def build_env_for_bubble(data: dict) -> dict:
    """Builds the environment dict for launching a bubble."""
    env = os.environ.copy()
    prefix = (data.get("prefix_path") or "").strip()
    if prefix:
        env["WINEPREFIX"] = prefix
    language = (data.get("language") or "").strip()
    if language:
        env["LC_ALL"] = language
        env["LANG"] = language
        env["LANGUAGE"] = language
    return env


def launch_with_wine(exec_path: str, data: dict, notify=None) -> tuple[bool, str | None]:
    """Launches a bubble's executable with wine. Returns (ok, error)."""
    wine_cmd = get_wine_local_command()
    if not shutil.which(wine_cmd):
        return False, tr("TOOL_MISSING") + wine_cmd
    args = [wine_cmd, str(exec_path)]
    env = build_env_for_bubble(data)
    cwd = str(Path(exec_path).parent) if exec_path else None

    env_prefix = []
    for k in ("WINEPREFIX", "LC_ALL", "LANG", "LANGUAGE"):
        if k in env and env[k] != os.environ.get(k):
            env_prefix.append(f'{k}="{env[k]}"')
    logged_args = [wine_cmd, f'"{exec_path}"']
    full_cmd = " ".join(env_prefix + logged_args)
    print(f"[LWL]: running: {full_cmd}")

    try:
        subprocess.Popen(
            args, env=env, cwd=cwd,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if notify is not None:
            notify(tr("APP_NAME"), tr("RUNNING_WINE"))
        return True, None
    except Exception as e:
        return False, str(e)


# ---------- .desktop generation ----------
def build_exec_line(data: dict) -> str:
    """Builds the Exec= line for a .desktop file."""
    env_parts = []
    prefix = (data.get("prefix_path") or "").strip()
    if prefix:
        env_parts.append(f'WINEPREFIX="{prefix}"')
    language = (data.get("language") or "").strip()
    if language:
        env_parts.append(f"LC_ALL={language}")
        env_parts.append(f"LANG={language}")
        env_parts.append(f"LANGUAGE={language}")
    exec_path = (data.get("exec_path") or "").strip()
    wine_cmd = get_wine_desktop_command()
    parts = []
    if env_parts:
        parts.append("env")
        parts.extend(env_parts)
    parts.append(wine_cmd)
    parts.append(f'"{exec_path}"')
    return " ".join(parts)


def write_desktop_for_bubble(data: dict, folder: Path) -> Path | None:
    """Writes a .desktop file for a bubble; returns the path or None."""
    safe_name = bubble_safe_name(data.get("name", ""))
    if not safe_name:
        return None
    folder = Path(folder)
    try:
        folder.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        print(f"[LWL]: failed to create {folder}: {e}")
        return None
    name = data.get("name", "")
    exec_path = data.get("exec_path", "")
    icon_path = data.get("gui_path", "") or "wine"
    category = data.get("category", "") or "Utility"
    exec_line = build_exec_line(data)
    path_line = str(Path(exec_path).parent) if exec_path else ""
    wm_class = Path(exec_path).name if exec_path else ""
    lines = [
        "[Desktop Entry]",
        f"Name={name}",
        f"Exec={exec_line}",
        f"Icon={icon_path}",
    ]
    if path_line:
        lines.append(f"Path={path_line}")
    if wm_class:
        lines.append(f"StartupWMClass={wm_class}")
    lines.extend([
        f"Categories={category};",
        "Type=Application",
        "StartupNotify=false",
        "Terminal=false",
    ])
    desktop_file = folder / f"bubble-{safe_name}.desktop"
    try:
        with open(desktop_file, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        os.chmod(desktop_file, 0o755)
        return desktop_file
    except Exception as e:
        print(f"[LWL]: failed to write {desktop_file}: {e}")
        return None


def remove_bubble_desktop(folder: Path, safe_name: str) -> None:
    """Removes a bubble's .desktop file from a folder."""
    folder = Path(folder)
    f = folder / f"bubble-{safe_name}.desktop"
    if f.is_file():
        try:
            f.unlink()
        except Exception as e:
            print(f"[LWL]: failed to remove {f}: {e}")


def regenerate_shortcuts(app: "App") -> None:
    """Regenerates all .desktop shortcuts from saved bubbles."""
    desktop_dir, applications_dir = get_shortcut_dirs()
    try:
        desktop_dir.mkdir(parents=True, exist_ok=True)
        applications_dir.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        app.notify(tr("ERROR_TITLE"), tr("ERROR_CREATING_SHORTCUTS_LOCATION", path=str(e)))
        return
    for _path, data in list_bubbles():
        name = data.get("name", "")
        safe_name = bubble_safe_name(name)
        if data.get("desktop_shortcut", False):
            write_desktop_for_bubble(data, desktop_dir)
        else:
            remove_bubble_desktop(desktop_dir, safe_name)
        if data.get("menu_shortcut", False):
            write_desktop_for_bubble(data, applications_dir)
        else:
            remove_bubble_desktop(applications_dir, safe_name)
    print("[LWL]: shortcuts updated.")
    app.notify(tr("UPDATE_SHORTCUTS"), tr("SHORTCUTS_UPDATED"))


