#!/bin/bash
# l-w-l - Little Wine Launcher

# Configuration
ICON_MSI_TEMPLATE="/snap/l-w-l/current/meta/gui/icon.svg"
APP_TITLE="Little Wine Launcher"

# Asks for a shortcut display name. Empty output means cancelled.
dlg_entry() {
    local title="$1" text="$2" default="$3"
    zenity --entry --title="$title" --text="$text" \
           --entry-text="$default" 2>/dev/null
}

# Asks for a folder to use as a Wine prefix. Empty output means cancelled.
dlg_select_dir() {
    local title="$1"
    zenity --file-selection --directory --title="$title" 2>/dev/null
}

# Asks for an icon file. Empty output means cancelled.
dlg_select_icon() {
    local title="$1"
    zenity --file-selection --title="$title" \
           --file-filter="Images | *.jpg *.jpeg *.png" \
           --file-filter="All files | *" 2>/dev/null
}

# Asks to pick one entry from a list. Prints the chosen value.
# Empty output means cancelled.
dlg_select() {
    local title="$1" text="$2" height="$3"
    shift 3

    local args=(--list --title="$title" --text="$text"
                --height="$height" --width=420
                --column="Item" --column="__val"
                --hide-column=2 --print-column=2 --hide-header)
    local entry display value
    for entry in "$@"; do
        IFS='|' read -r display value <<< "$entry"
        args+=("$display" "$value")
    done
    zenity "${args[@]}" 2>/dev/null
}

# Reports a failure.
dlg_error() {
    local title="$1" text="$2"
    zenity --error --title="$title" --text="$text" 2>/dev/null
}

# Reports a neutral message.
dlg_info() {
    local title="$1" text="$2"
    zenity --info --title="$title" --text="$text" 2>/dev/null
}

# Language detection
